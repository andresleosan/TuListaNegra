{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tulistanegra",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Un solo Worker: SPA estática + API (/api/*) + cron horario.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  // Base remota creada el 2026-11-14 (BAS-05). El id no es secreto: sin la sesión de la cuenta no sirve.
  "d1_databases": [{ "binding": "DB", "database_name": "tulistanegra", "database_id": "fbae6d8d-a998-46b2-8417-466ec1faf197", "migrations_dir": "migrations" }],
  // Archivos privados (capturas de pago, evidencias). Nunca se sirve una URL pública: solo por /api/archivos con sesión.
  "r2_buckets": [{ "binding": "ARCHIVOS", "bucket_name": "tulistanegra-archivos" }],
  // Límites de frecuencia (B5). La clave la pone el código: IP en altas, negocio en subidas.
  "ratelimits": [
    { "name": "LIMITE_ALTAS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_SUBIDAS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_IA", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    // Webhook público de WhatsApp, por IP. Holgado: Meta envía desde pocas IP y reintenta un 429.
    { "name": "LIMITE_WEBHOOK", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Interruptores (docs/spec/reglas.md, A3). Solo el dueño los enciende.
  "vars": {
    // Proyecto de Firebase de TuListaNegra (no es secreto: va en cada token). En local lo pisa .dev.vars con el simulador.
    "FIREBASE_PROJECT_ID": "tulistanegr4-app",
    "SIGNUP_READY": "0",
    "AI_READY": "0",
    "WHATSAPP_SEND_READY": "0",
    "SEMAFORO_READY": "0"
  }
}
