{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tulistanegra",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Un solo Worker: SPA estática + API (/api/*) + cron horario.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  // El database_id remoto se añade al crear la base (BAS-05). En local no hace falta.
  "d1_databases": [{ "binding": "DB", "database_name": "tulistanegra", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
  // Interruptores (docs/spec/reglas.md, A3). Solo el dueño los enciende.
  "vars": {
    "SIGNUP_READY": "0",
    "AI_READY": "0",
    "WHATSAPP_SEND_READY": "0",
    "SEMAFORO_READY": "0"
  }
}
